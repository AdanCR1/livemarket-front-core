---
import Layout from '../layouts/Layout.astro';
import { PlansCheckout } from '../components/plans/PlansCheckout';
import { enterpriseContactEmail, proCheckoutEnabled } from '../lib/server/plan-settings';
export const prerender = false;
const session = Astro.locals.session;
if (!session) return Astro.redirect('/login?next=%2Fplanes');
if (session.role !== 'B2B') return Astro.redirect('/perfil');
---
<Layout title="Planes para negocios" description="Activa una suscripción Pro para vender en MarketCloud">
  <main class="mx-auto max-w-6xl min-h-[calc(100vh-4rem)] px-4 sm:px-6 py-10">
    <div class="mb-8">
      <p class="text-sm font-semibold text-theme-primary uppercase tracking-widest">MarketCloud para negocios</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold text-market-white">Activa las compras en tu tienda</h1>
      <p class="mt-3 text-market-muted max-w-3xl text-sm md:text-base">
        El catálogo es gratuito. Con un plan de pago activo, tus clientes pueden reservar productos y pagar con Solari Móvil.
      </p>
    </div>
    <PlansCheckout client:load checkoutEnabled={proCheckoutEnabled} contactEmail={enterpriseContactEmail} />
  </main>
</Layout>
