---
import Layout404 from "../layouts/Layout404.astro";
import { FiArrowLeft } from "react-icons/fi";
---

<Layout404>
  <main class="relative min-h-screen w-full overflow-hidden bg-black flex items-center">
    <!-- Imagen de fondo (mockup) -->
    <div class="absolute inset-0 z-0">
      <img
        src="/img/404.avif"
        alt="Error 404 - Página no encontrada"
        class="w-full h-full object-cover object-center md:object-right"
        loading="eager"
      />
      <!-- Overlay para fundir con el negro -->
      <div class="absolute inset-0 bg-black/70 md:bg-transparent md:bg-gradient-to-r md:from-black md:via-black/80 md:to-transparent"></div>
    </div>

    <!-- Contenido -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-xl py-16 md:py-0">
        <span class="block text-xs sm:text-sm font-medium tracking-[0.3em] uppercase text-gray-400 mb-4 sm:mb-6">
          Error 404
        </span>

        <h1 class="text-[6rem] sm:text-[8rem] md:text-[10rem] lg:text-[12rem] font-black leading-none tracking-tighter bg-gradient-to-b from-white via-gray-300 to-gray-500 bg-clip-text text-transparent mb-4 sm:mb-6">
          404
        </h1>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4 sm:mb-6 leading-tight">
          Página no encontrada
        </h2>

        <p class="text-base sm:text-lg text-gray-400 leading-relaxed mb-8 sm:mb-10 max-w-md">
          Lo sentimos, la página que buscas no existe o fue movida a otro lugar.
        </p>

        <a
          href="/"
          class="inline-flex items-center gap-2 sm:gap-3 rounded-full border border-white/30 bg-white/5 backdrop-blur-sm px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-semibold text-white hover:bg-white hover:text-black transition-all duration-300 group"
        >
          <FiArrowLeft className="w-4 h-4 sm:w-5 sm:h-5 group-hover:-translate-x-1 transition-transform" />
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</Layout404>