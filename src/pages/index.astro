---
import Layout from "../layouts/Layout.astro";
import { NICHES } from "../lib/niches";
import { SITE_NAME } from "../lib/constants";
import {
  FiSearch,
  FiArrowRight,
  FiShoppingBag,
  FiTruck,
  FiShield,
  FiStar,
  FiTrendingUp,
  FiCheckCircle,
  FiUsers,
} from "react-icons/fi";

const steps = [
  {
    icon: FiSearch,
    title: "Busca",
    description:
      "Explora miles de productos y proveedores verificados en un solo lugar.",
  },
  {
    icon: FiShoppingBag,
    title: "Compara y compra",
    description:
      "Evalúa precios, reseñas y ubicación para tomar la mejor decisión.",
  },
  {
    icon: FiTruck,
    title: "Recibe",
    description: "Disfruta de envíos rápidos y seguimiento en tiempo real.",
  },
];

const testimonials = [
  {
    name: "María Fernández",
    role: "Compradora frecuente",
    quote:
      "Encontré proveedores confiables en minutos. La plataforma es intuitiva y el proceso de compra muy seguro.",
    avatar: "MF",
  },
  {
    name: "Carlos Gutiérrez",
    role: "Vendedor Premium",
    quote:
      "Desde que me uní a MARKETCLOUD mis ventas crecieron un 40%. La visibilidad que ofrece es increíble.",
    avatar: "CG",
  },
  {
    name: "Laura Méndez",
    role: "Gerente de Compras",
    quote:
      "La variedad de nichos y la calidad de los productos superaron mis expectativas. 100% recomendado.",
    avatar: "LM",
  },
];
---

<Layout>
  <!-- CONTENEDOR PRINCIPAL DEL CARRUSEL GLOBAL -->
  <main id="full-page-carousel" class="full-page-carousel">
    <!-- ===================== HERO (SLIDE 1) ===================== -->
    <section class="scroll-slide relative flex items-center bg-black">
      <!-- Video Background/Side -->
      <div
        class="absolute inset-0 z-0 flex items-center justify-center lg:left-auto lg:right-0 lg:w-[60%]"
      >
        <!-- Overlay oscuro+blur para móviles -->
        <div
          class="absolute inset-0 bg-market-darker/70 backdrop-blur-[3px] lg:hidden z-10"
        >
        </div>
        <!-- Máscara circular estricta -->
        <div
          class="w-full h-full relative z-0 [mask-image:linear-gradient(to_right,transparent_0%,black_25%,black_100%)]"
        >
          <video
            id="hero-video"
            class="w-full h-full object-cover"
            muted
            loop
            playsinline
            preload="none"
          >
            <!-- REEMPLAZA CON LA RUTA DE TU VIDEO -->
            <source src="/video/video-hero.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-20 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="w-full lg:w-[45%] flex flex-col justify-center">
          <div
            class="inline-flex w-max items-center gap-2 rounded-full border border-theme-primary/30 bg-theme-primary/10 px-4 py-1.5 text-xs sm:text-sm font-medium text-theme-primary mb-6"
          >
            <FiTrendingUp className="w-4 h-4" />
            Plataforma multi-negocio
          </div>

          <h1
            class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight text-market-white leading-tight"
          >
            Tu negocio tiene un lugar aquí
          </h1>

          <p class="mt-4 text-base sm:text-lg text-market-muted max-w-md">
            MARKETCLOUD conecta a todos los actores del comercio. Un mismo
            espacio para comprar, vender y crecer.
          </p>

          <div class="mt-8">
            <form
              class="relative flex flex-col sm:flex-row items-center gap-3"
              action="/buscar"
              method="GET"
            >
              <div class="relative w-full">
                <FiSearch
                  className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-market-muted"
                />
                <input
                  type="search"
                  name="q"
                  placeholder="Busca productos o servicios..."
                  class="w-full rounded-2xl border border-market-border bg-market-card/80 backdrop-blur py-4 pl-12 pr-4 text-market-white placeholder-market-muted/60 outline-none transition-all focus:border-theme-primary/60 focus:ring-2 focus:ring-theme-primary/20"
                />
              </div>
              <button
                type="submit"
                class="w-full sm:w-auto rounded-2xl bg-theme-primary px-6 py-4 font-semibold text-market-darker hover:bg-theme-primary/90 transition-all duration-200 flex items-center justify-center gap-2 shrink-0"
              >
                Buscar
                <FiArrowRight className="w-4 h-4" />
              </button>
            </form>
          </div>

          <div
            class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4"
          >
            {
              [
                { value: "10k+", label: "Productos" },
                { value: "2.5k+", label: "Negocios" },
                { value: "1.8k+", label: "Compradores" },
                { value: "98%", label: "Satisfacción" },
              ].map((stat) => (
                <div class="text-left">
                  <div class="text-2xl font-bold text-theme-primary">
                    {stat.value}
                  </div>
                  <div class="text-xs text-market-muted">{stat.label}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== NICHOS (SLIDES DINÁMICOS) ===================== -->
    {
      Object.values(NICHES).map((niche, index) => {
        const NicheIcon = niche.icon;
        const isActive = niche.active;
        const bgImages = [
          "/img/nichos-gastro.avif",
          "/img/nichos-tech.avif",
          "/img/nichos-moda.avif",
          "/img/nichos-jugueteria.avif",
          "/img/nichos-otros.avif",
        ];
        const bgImage = bgImages[index % bgImages.length];

        return (
          <section class="scroll-slide relative" data-index={index + 1}>
            <img
              src={bgImage}
              alt={niche.label}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 zoom-bg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/30" />

            <div class="absolute inset-0 flex flex-col justify-center px-6 md:px-20 max-w-7xl mx-auto w-full fade-content opacity-0 translate-y-8 transition-all duration-700">
              <div class="flex items-center gap-3 mb-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm text-white border border-white/20">
                  <NicheIcon className="w-6 h-6" />
                </div>
                <span class="text-sm font-bold tracking-widest uppercase text-theme-primary">
                  {isActive ? "Disponible ahora" : "Próximamente"}
                </span>
              </div>

              <h1 class="text-5xl md:text-8xl font-black mb-4 leading-none tracking-tighter uppercase text-white">
                {niche.label}
              </h1>

              <p class="text-gray-300 max-w-lg text-sm md:text-base mb-8 line-clamp-3">
                {niche.description}
              </p>

              <div class="flex items-center gap-4">
                {isActive ? (
                  <a
                    href={`/${niche.slug}`}
                    class="flex items-center gap-2 bg-white text-black px-6 md:px-8 py-3 md:py-4 rounded-full font-bold hover:bg-gray-200 transition"
                  >
                    Explorar {niche.label}
                  </a>
                ) : (
                  <button
                    class="flex items-center gap-2 bg-white/20 backdrop-blur text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold cursor-not-allowed"
                    disabled
                  >
                    Próximamente
                  </button>
                )}
              </div>
            </div>
          </section>
        );
      })
    }

    <!-- ===================== CÓMO FUNCIONA ===================== -->
    <section
      class="scroll-slide relative flex items-center bg-market-darker py-10"
    >
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-market-white">
            ¿Cómo funciona?
          </h2>
          <p class="mt-2 text-sm md:text-base text-market-muted">
            Tres simples pasos para empezar.
          </p>
        </div>

        <div
          class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 md:grid md:grid-cols-3 md:overflow-visible no-scrollbar"
        >
          {
            steps.map((step, index) => {
              const StepIcon = step.icon;
              return (
                <div class="min-w-[85vw] sm:min-w-[40vw] md:min-w-0 snap-center relative rounded-2xl border border-market-border bg-market-card p-6 md:p-8 text-center">
                  <div class="mx-auto flex h-12 w-12 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-theme-primary/10 text-theme-primary mb-4 md:mb-6">
                    <StepIcon className="w-6 h-6 md:w-7 md:h-7" />
                  </div>
                  <span class="absolute top-4 right-4 text-4xl font-bold text-market-border/30 select-none">
                    {index + 1}
                  </span>
                  <h3 class="text-lg md:text-xl font-semibold text-market-white mb-2">
                    {step.title}
                  </h3>
                  <p class="text-sm md:text-base text-market-muted">
                    {step.description}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ===================== CTA VENDEDORES ===================== -->
    <section
      class="scroll-slide relative flex items-center bg-market-darker/50"
    >
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
          class="relative overflow-hidden rounded-3xl border border-theme-primary/30 bg-theme-primary/10 p-6 sm:p-10 lg:p-16"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(232,93,38,0.2),_transparent_60%)]"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative flex flex-col lg:flex-row items-center justify-between gap-8"
          >
            <div class="max-w-xl text-center lg:text-left">
              <h2 class="text-3xl md:text-4xl font-bold text-market-white">
                ¿Listo para vender más?
              </h2>
              <p class="mt-4 text-sm md:text-lg text-market-muted">
                Crea tu tienda gratuita y llega a miles de compradores. Sin
                comisiones ocultas.
              </p>
              <div
                class="mt-6 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start"
              >
                <a
                  href="/registro/negocio"
                  class="inline-flex justify-center items-center gap-2 rounded-xl bg-theme-primary px-6 py-3 font-semibold text-market-darker hover:bg-theme-primary/90"
                >
                  <FiShoppingBag className="w-4 h-4" /> Crear tienda gratis
                </a>
                <a
                  href="/planes"
                  class="inline-flex justify-center items-center gap-2 rounded-xl border border-theme-primary/40 px-6 py-3 font-semibold text-theme-primary hover:bg-theme-primary/20"
                >
                  Ver planes
                </a>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
              <div class="flex flex-col gap-3 w-full">
                <div
                  class="flex items-center gap-2 rounded-xl bg-market-darker/80 px-4 py-3 text-sm text-market-white"
                >
                  <FiCheckCircle className="text-theme-primary" /> Sin comisión
                </div>
                <div
                  class="flex items-center gap-2 rounded-xl bg-market-darker/80 px-4 py-3 text-sm text-market-white"
                >
                  <FiUsers className="text-theme-primary" /> 10k+ compradores
                </div>
              </div>
              <div class="flex flex-col gap-3 w-full">
                <div
                  class="flex items-center gap-2 rounded-xl bg-market-darker/80 px-4 py-3 text-sm text-market-white"
                >
                  <FiShield className="text-theme-primary" /> Pagos protegidos
                </div>
                <div
                  class="flex items-center gap-2 rounded-xl bg-market-darker/80 px-4 py-3 text-sm text-market-white"
                >
                  <FiTrendingUp className="text-theme-primary" /> Analíticas avanzadas
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== TESTIMONIOS ===================== -->
    <section class="scroll-slide relative flex items-center bg-market-darker">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-market-white">
            Lo que dicen nuestros usuarios
          </h2>
          <p class="mt-2 text-sm md:text-base text-market-muted">
            Experiencias reales de la comunidad.
          </p>
        </div>

        <div
          class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 md:grid md:grid-cols-3 md:overflow-visible no-scrollbar"
        >
          {
            testimonials.map((t) => (
              <div class="min-w-[85vw] sm:min-w-[40vw] md:min-w-0 snap-center relative rounded-2xl border border-market-border bg-market-card p-6 md:p-8">
                <div class="flex items-center gap-1 text-theme-primary mb-4">
                  {[...Array(5)].map((_, i) => (
                    <FiStar key={i} className="w-4 h-4 fill-current" />
                  ))}
                </div>
                <blockquote class="text-market-white/90 italic text-sm md:text-base">
                  "{t.quote}"
                </blockquote>
                <div class="mt-6 flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-theme-primary/15 text-sm font-bold text-theme-primary">
                    {t.avatar}
                  </div>
                  <div>
                    <div class="font-medium text-market-white text-sm">
                      {t.name}
                    </div>
                    <div class="text-xs text-market-muted">{t.role}</div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SCROLL INDICATOR -->
    <div
      class="fixed right-4 md:right-6 top-1/2 transform -translate-y-1/2 flex flex-col gap-2 z-40 pointer-events-none"
    >
      <div
        class="w-1 h-24 bg-gray-600/50 rounded-full overflow-hidden relative"
      >
        <div
          id="scroll-progress"
          class="absolute top-0 left-0 w-full bg-theme-primary transition-all duration-300"
          style="height: 0%"
        >
        </div>
      </div>
    </div>

    <!-- NAVEGACIÓN -->
    <div class="fixed right-6 bottom-10 z-40 hidden md:flex flex-col gap-3">
      <button
        id="scroll-prev"
        class="w-10 h-10 bg-white/10 backdrop-blur rounded-full flex items-center justify-center hover:bg-white text-white hover:text-black transition"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 15l7-7 7 7"></path></svg
        >
      </button>
      <button
        id="scroll-next"
        class="w-10 h-10 bg-white/10 backdrop-blur rounded-full flex items-center justify-center hover:bg-white text-white hover:text-black transition"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path></svg
        >
      </button>
    </div>
  </main>
</Layout>

<script>
  const carousel = document.getElementById("full-page-carousel");
  const slides = document.querySelectorAll(".scroll-slide");
  const scrollProgress = document.getElementById("scroll-progress");
  const video = document.getElementById("hero-video");

  let currentSlideIndex = 0;

  // Lógica del Video (Reproducción inteligente)
  if (video) {
    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {}); // Evitar errores si el navegador bloquea autoplay
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.3 },
    ); // Activa cuando el 30% es visible
    videoObserver.observe(video);
  }

  // Observer del Carrusel Principal
  const observerOptions = {
    root: carousel,
    threshold: 0.5,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const index = Array.from(slides).indexOf(entry.target);
        currentSlideIndex = index;

        // Progreso lateral
        if (scrollProgress) {
          const progress = ((index + 1) / slides.length) * 100;
          scrollProgress.style.height = `${progress}%`;
        }

        // Animación de slides (imágenes y texto)
        slides.forEach((slide, i) => {
          const content = slide.querySelector(".fade-content");
          const bg = slide.querySelector(".zoom-bg");

          if (content && bg) {
            if (i === index) {
              content.classList.remove("opacity-0", "translate-y-8");
              content.classList.add("opacity-100", "translate-y-0");
              bg.style.transform = "scale(1.05)";
            } else {
              content.classList.add("opacity-0", "translate-y-8");
              content.classList.remove("opacity-100", "translate-y-0");
              bg.style.transform = "scale(1)";
            }
          }
        });
      }
    });
  }, observerOptions);

  slides.forEach((slide) => observer.observe(slide));

  // Controles
  function scrollToSlide(direction) {
    const newIndex =
      direction === "next" ? currentSlideIndex + 1 : currentSlideIndex - 1;
    if (newIndex >= 0 && newIndex < slides.length) {
      slides[newIndex].scrollIntoView({ behavior: "smooth" });
    }
  }

  document
    .getElementById("scroll-prev")
    ?.addEventListener("click", () => scrollToSlide("prev"));
  document
    .getElementById("scroll-next")
    ?.addEventListener("click", () => scrollToSlide("next"));

  // Eventos de teclado y control de scroll sensible
  let isScrolling = false;

  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") scrollToSlide("next");
    if (e.key === "ArrowUp") scrollToSlide("prev");
  });

  if (carousel) {
    carousel.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault(); // Previene comportamiento errático
        if (isScrolling) return;
        isScrolling = true;
        scrollToSlide(e.deltaY > 0 ? "next" : "prev");
        setTimeout(() => {
          isScrolling = false;
        }, 800); // Cooldown ajustado
      },
      { passive: false },
    );

    // Touch en el contenedor principal
    let touchStartY = 0;
    carousel.addEventListener(
      "touchstart",
      (e) => {
        touchStartY = e.touches[0].clientY;
      },
      { passive: true },
    );
    carousel.addEventListener(
      "touchend",
      (e) => {
        const diff = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(diff) > 50) scrollToSlide(diff > 0 ? "next" : "prev");
      },
      { passive: true },
    );
  }

  window.addEventListener("load", () => {
    if (slides.length > 0 && scrollProgress) {
      scrollProgress.style.height = `${(1 / slides.length) * 100}%`;
    }
  });
</script>

<style is:global>
  /* --- CARRUSEL VERTICAL COMPLETO --- */
  .full-page-carousel {
    height: 100vh;
    width: 100vw;
    overflow-y: scroll;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    background-color: var(--market-darker); /* Fondo base seguro */
  }

  .full-page-carousel::-webkit-scrollbar {
    display: none;
  }
  .full-page-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scroll-slide {
    height: 100vh;
    width: 100vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
  }

  /* Ocultar barra de scroll en elementos horizontales (móvil) */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
