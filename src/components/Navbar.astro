
---
/**
 * Navbar global de MarketCloud.
 * Astro SSR + react-icons.
 * Navegación tecnológica responsive.
 */

import { SITE_NAME } from "../lib/constants";

import {
  FiUser,
  FiSearch,
  FiMenu,
  FiShoppingBag,
  FiGrid,
  FiChevronDown,
  FiSmartphone,
  FiMonitor,
  FiCpu,
  FiHeadphones,
  FiTablet,
  FiHardDrive,
  FiMousePointer,
  FiBox,
  FiX,
} from "react-icons/fi";

const links = [
  {
    label: "Productos",
    href: "/buscar",
    icon: FiShoppingBag,
  },
  {
    label: "Tiendas",
    href: "/tecnologia",
    icon: FiMonitor,
  },
];

const shortcuts = [
  {
    label: "Celulares y smartphones",
    q: "celulares",
    icon: FiSmartphone,
  },
  {
    label: "Laptops y notebooks",
    q: "laptops",
    icon: FiMonitor,
  },
  {
    label: "Tablets",
    q: "tablets",
    icon: FiTablet,
  },
  {
    label: "Computadoras",
    q: "computadoras",
    icon: FiHardDrive,
  },
  {
    label: "Componentes",
    q: "componentes",
    icon: FiCpu,
  },
  {
    label: "Periféricos",
    q: "perifericos",
    icon: FiMousePointer,
  },
  {
    label: "Audífonos y audio",
    q: "audifonos",
    icon: FiHeadphones,
  },
  {
    label: "Gaming",
    q: "gaming",
    icon: FiMonitor,
  },
  {
    label: "Accesorios",
    q: "accesorios",
    icon: FiBox,
  },
];

const search =
  Astro.url.pathname === "/buscar"
    ? Astro.url.searchParams.get("q") ?? ""
    : "";

const session = Astro.locals.session as {
  role?: string;
  exp?: number;
} | null;

const exp =
  typeof session?.exp === "number"
    ? session.exp
    : null;

const accountActive =
  !!session &&
  (exp === null || exp * 1000 > Date.now());

const accountHref = accountActive
  ? session.role === "B2B"
    ? "/panel"
    : session.role === "DRIVER"
      ? "/mis-envios"
      : "/perfil"
  : "/login";

const accountLabel = accountActive
  ? "Mi cuenta"
  : "Iniciar sesión";

const underlineClass =
  "relative inline-flex items-center gap-1.5 " +
  "after:absolute after:bottom-0 after:left-0 " +
  "after:h-[2px] after:w-full after:rounded-full " +
  "after:bg-theme-primary after:content-[''] " +
  "after:origin-left after:scale-x-0 " +
  "after:transition-transform after:duration-300 " +
  "hover:after:scale-x-100 " +
  "focus-visible:after:scale-x-100";
---

<header
  class="sticky top-0 z-50 border-b border-market-border/50 bg-market-darker/95 backdrop-blur-xl"
>
  <div
    class="mx-auto flex w-full max-w-7xl items-center gap-2 px-3 py-3 sm:gap-3 sm:px-4 lg:gap-5"
  >
    <!-- LOGO + NOMBRE SOLO EN ESCRITORIO -->
    <a
      href="/"
      aria-label="MarketCloud — Inicio"
      class="flex shrink-0 items-center gap-2.5 no-underline"
    >
      <img
        src="/logo.webp"
        alt="MarketCloud"
        class="h-9 w-9 object-contain sm:h-10 sm:w-10"
      />

      <span
        class="hidden font-display text-lg font-bold tracking-tight lg:inline"
      >
        {SITE_NAME}
      </span>
    </a>

    <!-- NAVEGACIÓN ESCRITORIO -->
    <nav
      class="hidden shrink-0 items-center gap-5 lg:flex"
      aria-label="Navegación principal"
    >
      {
        links.map(({ label, href }) => (
          <a
            href={href}
            aria-current={
              Astro.url.pathname === href
                ? "page"
                : undefined
            }
            class:list={[
              underlineClass,
              "py-2 text-sm transition-colors hover:text-theme-primary",
              Astro.url.pathname === href &&
                "text-theme-primary",
            ]}
          >
            {label}
          </a>
        ))
      }

      <!-- MEGAMENÚ ESCRITORIO -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="true"
          class:list={[
            underlineClass,
            "py-2 text-sm transition-colors hover:text-theme-primary",
          ]}
        >
          Categorías
          <FiChevronDown
            size={15}
            className="transition-transform duration-200 group-hover:rotate-180"
          />
        </button>

        <div
          class="invisible absolute left-0 top-full z-50 w-96 translate-y-1 rounded-xl border border-market-border bg-market-darker p-4 opacity-0 shadow-2xl transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <div class="mb-3 border-b border-market-border/50 pb-3">
            <p class="text-sm font-semibold">
              Explora tecnología
            </p>
            <p class="mt-1 text-xs text-gray-400">
              Encuentra lo que necesitas
            </p>
          </div>

          <ul class="grid grid-cols-2 gap-x-4 gap-y-1">
            {
              shortcuts.map(
                ({ label, q, icon: Icon }) => (
                  <li>
                    <a
                      class="group/item flex items-center gap-2 rounded-lg px-2 py-2.5 text-sm transition-colors hover:bg-market-card hover:text-theme-primary"
                      href={`/buscar?${new URLSearchParams({ q })}`}
                    >
                      <Icon
                        size={17}
                        className="shrink-0 opacity-70 transition-colors group-hover/item:opacity-100"
                      />

                      <span
                        class="relative after:absolute after:bottom-[-3px] after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-theme-primary after:transition-transform after:duration-300 group-hover/item:after:scale-x-100 group-focus-within/item:after:scale-x-100"
                      >
                        {label}
                      </span>
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </div>
      </div>
    </nav>

    <!-- BUSCADOR RESPONSIVE -->
    <form
      action="/buscar"
      method="get"
      role="search"
      class="relative flex min-w-0 flex-1 items-center lg:ml-auto lg:max-w-sm"
    >
      <input
        aria-label="Buscar tecnología"
        class="h-10 w-full min-w-0 rounded-lg border border-market-border bg-market-card py-2 pl-3 pr-10 text-sm outline-none transition-colors focus:border-theme-primary sm:pl-4"
        type="search"
        name="q"
        maxlength="120"
        value={search}
        placeholder="Buscar tecnología"
      />

      <button
        type="submit"
        aria-label="Buscar"
        class="absolute right-0 flex h-10 w-10 items-center justify-center rounded-r-lg transition-colors hover:text-theme-primary"
      >
        <FiSearch size={19} />
      </button>
    </form>

    <!-- CUENTA ESCRITORIO -->
    <a
      class="hidden shrink-0 items-center gap-2 rounded-lg border border-market-border px-3 py-2 text-sm transition-colors hover:border-theme-primary hover:text-theme-primary lg:flex"
      href={accountHref}
    >
      <FiUser size={17} />
      {accountLabel}
    </a>

    <!-- MENÚ MÓVIL -->
    <details
      id="market-mobile-menu"
      class="relative shrink-0 lg:hidden"
    >
      <summary
        aria-label="Abrir menú de navegación"
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-market-border transition-colors hover:border-theme-primary hover:text-theme-primary [&::-webkit-details-marker]:hidden"
      >
        <span class="menu-open-icon">
          <FiMenu size={23} />
        </span>

        <span class="menu-close-icon hidden">
          <FiX size={23} />
        </span>
      </summary>

      <!-- FONDO OSCURO DETRÁS DEL MENÚ -->
      <button
        type="button"
        data-close-mobile-menu
        aria-label="Cerrar menú de navegación"
        class="mobile-menu-backdrop fixed inset-0 z-[-1] hidden cursor-default bg-black/60 backdrop-blur-[3px]"
      ></button>

      <!-- PANEL MÓVIL -->
      <nav
        class="mobile-menu-panel absolute right-0 top-full z-10 mt-3 w-[min(19rem,calc(100vw-1.5rem))] max-h-[calc(100dvh-5.5rem)] overflow-y-auto overscroll-contain rounded-2xl border border-market-border bg-market-darker p-4 shadow-2xl"
        aria-label="Navegación móvil"
      >
        <div class="mb-3 border-b border-market-border/50 pb-3">
          <p class="text-sm font-semibold">
            Explorar MarketCloud
          </p>
          <p class="mt-1 text-xs text-gray-400">
            Tecnología en Sucre
          </p>
        </div>

        <!-- ENLACES PRINCIPALES -->
        <div class="space-y-1">
          {
            links.map(({ label, href, icon: Icon }) => (
              <a
                href={href}
                aria-current={
                  Astro.url.pathname === href
                    ? "page"
                    : undefined
                }
                class:list={[
                  "flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-market-card hover:text-theme-primary",
                  Astro.url.pathname === href &&
                    "bg-market-card text-theme-primary",
                ]}
              >
                <Icon size={19} className="shrink-0" />
                <span>{label}</span>
              </a>
            ))
          }
        </div>

        <!-- CATEGORÍAS EXPANDIBLES -->
        <details class="mobile-categories group/categories mt-1">
          <summary
            class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-market-card hover:text-theme-primary [&::-webkit-details-marker]:hidden"
          >
            <span class="flex items-center gap-3">
              <FiGrid size={19} />
              Categorías
            </span>

            <FiChevronDown
              size={17}
              className="transition-transform duration-200 group-open/categories:rotate-180"
            />
          </summary>

          <ul
            class="ml-5 mt-1 max-h-64 space-y-1 overflow-y-auto border-l border-market-border/60 pl-3"
          >
            {
              shortcuts.map(
                ({ label, q, icon: Icon }) => (
                  <li>
                    <a
                      href={`/buscar?${new URLSearchParams({ q })}`}
                      class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-300 transition-colors hover:bg-market-card hover:text-theme-primary"
                    >
                      <Icon
                        size={17}
                        className="shrink-0"
                      />
                      <span>{label}</span>
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </details>

        <!-- USUARIO -->
        <div class="mt-3 border-t border-market-border/50 pt-3">
          <a
            href={accountHref}
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-market-card hover:text-theme-primary"
          >
            <FiUser size={19} />
            <span>{accountLabel}</span>
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Subrayado fluido sin desplazamiento del texto */
  @media (prefers-reduced-motion: reduce) {
    header a,
    header button,
    header span,
    header nav {
      transition-duration: 0ms !important;
    }
  }

  #market-mobile-menu[open] .mobile-menu-backdrop {
    display: block;
  }

  #market-mobile-menu[open] .menu-open-icon {
    display: none;
  }

  #market-mobile-menu[open] .menu-close-icon {
    display: flex;
  }

  .mobile-menu-panel {
    transform-origin: top right;
    animation: mobile-menu-in 180ms ease-out;
  }

  @keyframes mobile-menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel {
      animation: none;
    }
  }
</style>

<script>
  function initMarketMobileMenu() {
    const menu = document.querySelector<HTMLDetailsElement>(
      "#market-mobile-menu"
    );

    if (!menu || menu.dataset.initialized === "true") {
      return;
    }

    menu.dataset.initialized = "true";

    const backdrop = menu.querySelector<HTMLButtonElement>(
      "[data-close-mobile-menu]"
    );

    const closeMenu = () => {
      menu.open = false;
    };

    backdrop?.addEventListener("click", closeMenu);

    menu.querySelectorAll<HTMLAnchorElement>("nav a").forEach(
      (link) => {
        link.addEventListener("click", closeMenu);
      }
    );

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        closeMenu();

        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    });

    const desktopQuery = window.matchMedia(
      "(min-width: 1024px)"
    );

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) {
        closeMenu();
      }
    });
  }

  document.addEventListener(
    "astro:page-load",
    initMarketMobileMenu
  );

  initMarketMobileMenu();
</script>
