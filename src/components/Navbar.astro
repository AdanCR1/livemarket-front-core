---
/**
 * Navbar global de MARKETCLOUD.
 * Componente Astro estático. Usa iconos de React en server-side rendering.
 * Los mega menús se manejan con vanilla JS.
 */
import { NICHES } from "../lib/niches";
import { SITE_NAME } from "../lib/constants";
import {
  FiChevronDown,
  FiLogIn,
  FiUserPlus,
  FiShoppingBag,
  FiUser,
} from "react-icons/fi";

interface Props {
  /** Slug del nicho activo para resaltar en el nav */
  activeNiche?: string;
}

const { activeNiche } = Astro.props;
const nicheEntries = Object.values(NICHES);
---

<header
  class="sticky top-0 z-50 w-full border-b border-market-border/50 bg-market-darker/80 backdrop-blur-xl"
>
  <div class="relative">
    <!-- Barra principal -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <!-- Logo -->
        <a href="/" class="group flex items-center gap-3 no-underline">
          <div
            class="flex h-9 w-9 items-center justify-center group-hover:scale-110"
          >
            <img class="w-10 h-auto" src="/logo.webp" alt="Logo" />
          </div>
          <span class="text-lg font-bold tracking-tight text-market-white">
            {SITE_NAME}
          </span>
        </a>

        <!-- Nichos (desktop) -->
        <div class="hidden md:flex items-center gap-1">
          {
            nicheEntries.map((niche) => {
              const NicheIcon = niche.icon;
              return (
                <div class="relative" data-mega-wrapper>
                  <a
                    href={niche.active ? `/${niche.slug}` : "#"}
                    class:list={[
                      "flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 no-underline",
                      activeNiche === niche.slug
                        ? "bg-theme-primary/15 text-theme-primary"
                        : niche.active
                          ? "text-market-muted hover:text-market-white hover:bg-market-card"
                          : "text-market-muted/40 cursor-default",
                    ]}
                    aria-haspopup={niche.megaMenu ? "true" : undefined}
                    aria-expanded={niche.megaMenu ? "false" : undefined}
                    aria-controls={
                      niche.megaMenu ? `mega-panel-${niche.slug}` : undefined
                    }
                    data-mega-trigger={niche.megaMenu ? niche.slug : undefined}
                  >
                    <span class="flex items-center">
                      <NicheIcon className="w-4 h-4" />
                    </span>
                    {niche.label}
                    {niche.megaMenu && (
                      <FiChevronDown className="w-3.5 h-3.5 transition-transform duration-200" />
                    )}
                  </a>
                </div>
              );
            })
          }
        </div>

        <!-- Acciones de cuenta (desktop) -->
        <div class="hidden md:flex items-center gap-2">
          <a
            href="/login"
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all no-underline text-market-muted hover:text-market-white hover:bg-market-card"
            aria-label="Iniciar sesión o crear cuenta"
          >
            <FiUser className="w-5 h-5" />
            <span class="hidden lg:inline">Mi cuenta</span>
          </a>
        </div>

        <!-- Botón menú mobile -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl text-market-muted hover:text-market-white hover:bg-market-card transition-colors"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Paneles de mega menú (desktop) -->
    {
      nicheEntries
        .filter((niche) => niche.megaMenu)
        .map((niche) => (
          <div
            id={`mega-panel-${niche.slug}`}
            data-mega-panel
            class="hidden absolute left-0 right-0 top-full z-50 px-4 sm:px-6 lg:px-8"
          >
            <div class="mx-auto max-w-7xl pt-4 pb-8">
              <div class="rounded-3xl border border-market-border/60 bg-market-card/95 backdrop-blur-xl shadow-2xl p-6 sm:p-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                  {niche.megaMenu?.map((column) => (
                    <div>
                      <h3 class="text-xs uppercase tracking-widest text-market-muted font-semibold mb-4">
                        {column.title}
                      </h3>
                      <ul class="space-y-3">
                        {column.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="group/link block rounded-xl px-3 py-2 -mx-3 hover:bg-market-darker/60 transition-colors no-underline"
                            >
                              <span class="block text-sm font-medium text-market-white group-hover/link:text-theme-primary">
                                {link.label}
                              </span>
                              {link.description && (
                                <span class="block text-xs text-market-muted mt-0.5">
                                  {link.description}
                                </span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
    }
  </div>

  <!-- Menú mobile -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-market-border/50 bg-market-darker/95 backdrop-blur-xl"
  >
    <div class="px-4 py-3 space-y-1">
      {
        nicheEntries.map((niche) => {
          const NicheIcon = niche.icon;

          if (niche.megaMenu) {
            return (
              <details class="group">
                <summary class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-market-muted hover:text-market-white hover:bg-market-card cursor-pointer list-none transition-colors">
                  <span class="flex items-center">
                    <NicheIcon className="w-4 h-4" />
                  </span>
                  {niche.label}
                  <FiChevronDown class="ml-auto w-4 h-4 transition-transform group-open:rotate-180" />
                </summary>
                <div class="pl-6 pr-2 py-2 space-y-1 border-l border-market-border/50 ml-4">
                  {niche.megaMenu.map((column) => (
                    <div class="mb-3">
                      <p class="text-xs uppercase tracking-widest text-market-muted/40 font-bold mb-2">
                        {column.title}
                      </p>
                      {column.links.map((link) => (
                        <a
                          href={link.href}
                          class="block px-3 py-2 rounded-lg text-sm text-market-muted hover:text-market-white hover:bg-market-card no-underline transition-colors"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </details>
            );
          }

          return (
            <a
              href={niche.active ? `/${niche.slug}` : "#"}
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all no-underline",
                activeNiche === niche.slug
                  ? "bg-theme-primary/15 text-theme-primary"
                  : niche.active
                    ? "text-market-muted hover:text-market-white hover:bg-market-card"
                    : "text-market-muted/40 cursor-default",
              ]}
            >
              <span class="flex items-center">
                <NicheIcon className="w-4 h-4" />
              </span>
              {niche.label}
              {!niche.active && (
                <span class="ml-auto text-[10px] uppercase tracking-widest text-market-muted/30 font-bold">
                  Pronto
                </span>
              )}
            </a>
          );
        })
      }
    </div>

    <!-- Acciones de cuenta en mobile -->
    <div class="px-4 py-4 border-t border-market-border/50">
      <a
        href="/login"
        class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-market-muted hover:text-market-white hover:bg-market-card no-underline transition-colors"
      >
        <FiUser className="w-5 h-5" />
        Mi cuenta
      </a>
    </div>
  </div>
</header>

<script>
  // Toggle menú mobile
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isOpen = !menu.classList.contains("hidden");
    menu.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isOpen));
  });

  // Mega menús desktop
  const wrappers = document.querySelectorAll("[data-mega-wrapper]");
  const panels = Array.from(document.querySelectorAll("[data-mega-panel]"));
  let hideTimeout;

  function hideAllPanels() {
    panels.forEach((panel) => panel.classList.add("hidden"));
    wrappers.forEach((wrapper) => {
      const trigger = wrapper.querySelector("[data-mega-trigger]");
      trigger?.setAttribute("aria-expanded", "false");
    });
  }

  wrappers.forEach((wrapper) => {
    const trigger = wrapper.querySelector("[data-mega-trigger]");
    const slug = trigger?.getAttribute("data-mega-trigger");
    const panel = slug ? document.getElementById(`mega-panel-${slug}`) : null;

    if (!trigger || !panel) return;

    const show = () => {
      clearTimeout(hideTimeout);
      hideAllPanels();
      panel.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
    };

    const scheduleHide = () => {
      clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => {
        hideAllPanels();
      }, 150);
    };

    wrapper.addEventListener("mouseenter", show);
    wrapper.addEventListener("mouseleave", scheduleHide);
    panel.addEventListener("mouseenter", show);
    panel.addEventListener("mouseleave", scheduleHide);

    trigger.addEventListener("focus", show);

    wrapper.addEventListener("focusout", (event) => {
      if (
        !wrapper.contains(event.relatedTarget) &&
        !panel.contains(event.relatedTarget)
      ) {
        scheduleHide();
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      hideAllPanels();
    }
  });
</script>
